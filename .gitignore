# ---------------------------------------------------------------------------
# Portside — .gitignore
#
# NOTE: Task B of this brief calls out "secrets in the repo" as a defect.
# Nothing in this project may ever commit a credential. `.env*` is ignored
# below with a single explicit exception for `.env.example`, which contains
# key NAMES only and never values.
# ---------------------------------------------------------------------------

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json

# --- Next.js build output --------------------------------------------------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# --- Turbopack / bundler caches --------------------------------------------
.turbo/
.swc/
.cache/

# --- Testing ---------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/          # saved storageState — contains real session tokens

# Vitest
.vitest/
vitest.config.ts.timestamp-*

# --- Supabase CLI ----------------------------------------------------------
# Keep supabase/migrations/ and supabase/config.toml — they ARE the schema.
supabase/.temp/
supabase/.branches/
supabase/logs/
supabase/seed-local.sql

# --- Deployment ------------------------------------------------------------
.vercel/
.netlify/

# --- Logs ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# --- Editors ---------------------------------------------------------------
.idea/
*.swp
*.swo
*~

# VS Code: share recommended extensions + settings, ignore everything else
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- OS --------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Misc ------------------------------------------------------------------
*.tgz
.eslintcache
.stylelintcache
tmp/
temp/
scratch/
